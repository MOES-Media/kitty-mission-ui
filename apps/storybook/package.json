{
  "name": "@spec-kitty/storybook-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@spec-kitty/elements": "1.1.0-rc.10",
    "@spec-kitty/mission-ui": "workspace:*",
    "@spec-kitty/styles": "1.1.0-rc.10",
    "@spec-kitty/tokens": "1.1.0-rc.10",
    "lit": "3.3.3"
  },
  "scripts": {
