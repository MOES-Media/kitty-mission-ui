{
  "name": "kitty-mission-ui",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@11.18.0+sha512.33d83c77da82f49fba836925c6f1b841181ec3132b670639bd012f7075f5c7cf634c5f870147c19aae7478fac01df09d8892e880454896edd23ee9b33757563c",
  "engines": {
    "node": "22.22.2",
    "pnpm": "11.18.0"
  },
  "scripts": {
    "preflight": "node scripts/preflight.mjs",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . --max-warnings 0",
    "lint:styles": "stylelint \"packages/*/src/**/*.{css,ts,mts,cts,tsx,js,mjs,cjs,jsx,svelte}\"",
    "lint:no-io": "eslint -c eslint.no-io.config.mjs packages/*/src",
    "test:no-io": "vitest run --config gates/vitest.config.ts gates/no-io.selftest.ts gates/markdown-lint.selftest.ts",
    "lint:data-driven": "eslint -c eslint.data-driven.config.mjs packages/*/src",
    "test:data-driven": "vitest run --config gates/vitest.config.ts gates/data-driven.selftest.ts",
    "manifest:generate": "pnpm --filter @moes-media/mission-ui manifest:generate",
    "manifest:check": "node scripts/check-manifest.mjs && node scripts/typings.mjs --check",
    "hygiene": "node scripts/check-hygiene.mjs",
    "test": "pnpm -r --no-bail --workspace-concurrency=1 test",
    "storybook": "pnpm --filter @moes-media/storybook-app storybook",
    "storybook:build-only": "pnpm --filter @moes-media/storybook-app build",
    "build-storybook": "pnpm storybook:build-only && node scripts/check-hygiene.mjs --storybook-static",
    "visual:run": "pnpm --filter @moes-media/storybook-app visual:run",
    "visual": "pnpm build-storybook && bash scripts/visual.sh",
    "visual:update": "pnpm build-storybook && bash scripts/visual.sh --update",
    "gate-proof": "node scripts/gate-proof.mjs",
    "test:preflight": "node --test scripts/preflight.test.mjs",
    "test:manifest-screen": "node --test scripts/manifest-screen.test.mjs scripts/settle.test.mjs",
    "contract:generate": "node scripts/contract/generate.mjs",
    "contract:check": "node scripts/contract/check.mjs",
    "contract:update": "node scripts/contract/update.mjs",
    "contract:verify-remote": "node scripts/contract/verify-remote.mjs",
    "test:contract": "node --test scripts/contract/*.test.mjs",
    "test:scripts": "node --test scripts/hygiene scripts/gate-proof scripts/preflight.test.mjs scripts/manifest-screen.test.mjs scripts/settle.test.mjs scripts/stylelint-exceptions.test.mjs scripts/terminology.test.mjs scripts/bundle-budget.test.mjs scripts/artifact-story-catalogue.test.mjs scripts/perf-split.test.mjs scripts/wp-story-catalogue.test.mjs scripts/drift-story-catalogue.test.mjs scripts/ops-story-catalogue.test.mjs scripts/visual-tags.test.mjs scripts/typings.test.mjs",
    "test:terminology": "node scripts/terminology.mjs && node --test scripts/terminology.test.mjs scripts/drift-story-catalogue.test.mjs",
    "contract:drift": "node scripts/contract/drift.mjs"
  },
  "devDependencies": {
    "@apidevtools/json-schema-ref-parser": "16.0.3",
    "@custom-elements-manifest/analyzer": "0.11.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.62.1",
    "@storybook/addon-docs": "10.6.1",
    "@storybook/web-components-vite": "10.6.1",
    "@sveltejs/vite-plugin-svelte": "6.2.4",
    "@types/node": "22.20.4",
    "@vitest/browser": "4.1.11",
    "@vitest/browser-playwright": "4.1.11",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "9.39.5",
    "eslint-plugin-lit": "2.3.1",
    "eslint-plugin-svelte": "3.23.0",
    "openapi-typescript": "7.13.0",
    "postcss-html": "2.0.0",
    "postcss-lit": "1.4.1",
    "storybook": "10.6.1",
    "stylelint": "16.26.1",
    "stylelint-declaration-strict-value": "1.12.1",
    "svelte": "5.57.1",
    "svelte-check": "4.7.6",
    "svelte-eslint-parser": "1.8.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "7.3.6",
    "vitest": "4.1.11",
    "yaml": "2.9.1"
  }
}
