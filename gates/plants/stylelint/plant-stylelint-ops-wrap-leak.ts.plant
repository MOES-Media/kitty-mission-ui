import { css } from 'lit';

// Exception E-43 allows `overflow-wrap: anywhere` in ops-row-parts.ts only, and E-42 the ellipsis keywords in the row and page
// parts only; the same declarations in any other file of the directory must still fail (no leak).
export const plantStylelintOpsWrapLeak = css`
  .plant-stylelint-ops-wrap-leak {
    overflow-wrap: anywhere;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
`;
